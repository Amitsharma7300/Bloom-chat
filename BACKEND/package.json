{
  "name": "bloomchat-backend",
  "version": "1.0.0",
  "description": "Backend for Bloomchat",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test:e2e": "npm run build && node scripts/e2e.mjs && node scripts/ads-e2e.mjs && node scripts/creator-e2e.mjs"
  },
  "engines": { "node": ">=22.13" },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
